{
  "manifest_version": 3,
  "name": "Sprint Tracker",
  "version": "1.2.0",
  "description": "Track the active sprint on any Atlassian board, with dev-done and released-live flags and per-ticket reminders.",
  "permissions": ["alarms", "storage", "sidePanel", "windows", "system.display"],
  "host_permissions": [
    "https://*.atlassian.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Sprint Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
